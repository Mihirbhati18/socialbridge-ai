# Database Configuration
# Local SQLite database URL (already set for Prisma)
DATABASE_URL="file:./dev.db"

# AI Providers (At least one is required for the AI Engine)
# Get a free Groq API key here: https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"

# Get a free Gemini API key here: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# Email Delivery (Optional, for sending real emails via the AI Outreach tool)
# Get a free Resend API key here: https://resend.com/
RESEND_API_KEY="your_resend_api_key_here"

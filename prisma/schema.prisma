generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  image         String?
  role          String    @default("CITIZEN")
  phone         String?
  city          String?
  state         String?
  lat           Float?
  lng           Float?
  bio           String?
  skills        String    @default("") // comma-separated
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  memberships    OrgMember[]
  collabRequests CollabRequest[]
  civicIssues    CivicIssue[]
  notifications  Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  expires   DateTime
  createdAt DateTime @default(now())
}

model Organization {
  id               String   @id @default(cuid())
  name             String
  type             String
  description      String
  logo             String?
  email            String
  phone            String?
  address          String
  city             String
  state            String
  lat              Float
  lng              Float
  categories       String   @default("")
  verified         Boolean  @default(false)
  rating           Float    @default(4.0)
  totalEvents      Int      @default(0)
  successfulEvents Int      @default(0)
  responseTimeHrs  Int      @default(24)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  members         OrgMember[]
  scores          PartnershipScore[]
  collabRequests  CollabRequest[]
  partnershipOrgs PartnershipOrg[]
}

model OrgMember {
  id     String @id @default(cuid())
  userId String
  orgId  String
  role   String @default("MEMBER")

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

model PartnershipScore {
  id                  String @id @default(cuid())
  orgId               String
  category            String
  totalCollaborations Int    @default(0)
  successRate         Float  @default(0.8)
  avgRating           Float  @default(4.0)
  reliabilityScore    Float  @default(0.8)
  responseScore       Float  @default(0.7)
  overallScore        Float  @default(0.75)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, category])
}

model CollabRequest {
  id               String    @id @default(cuid())
  title            String
  description      String
  category         String
  requiredPartners String    @default("")
  city             String
  state            String
  lat              Float?
  lng              Float?
  radiusKm         Int       @default(25)
  eventDate        DateTime?
  budget           Float?
  volunteersNeeded Int?
  status           String    @default("OPEN")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  creatorId        String
  orgId            String?

  creator   User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  org       Organization?    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  responses CollabResponse[]
  partnership Partnership?
}

model CollabResponse {
  id        String   @id @default(cuid())
  requestId String
  orgId     String
  orgName   String
  message   String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  request CollabRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model Partnership {
  id        String    @id @default(cuid())
  requestId String    @unique
  status    String    @default("ACTIVE")
  startDate DateTime
  endDate   DateTime?

  request  CollabRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  orgs     PartnershipOrg[]
  tasks    Task[]
  messages WorkspaceMessage[]
  documents Document[]
}

model PartnershipOrg {
  id            String @id @default(cuid())
  partnershipId String
  orgId         String
  role          String @default("PARTNER")

  partnership Partnership  @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Task {
  id            String    @id @default(cuid())
  partnershipId String
  title         String
  description   String?
  assignee      String?
  status        String    @default("TODO")
  priority      String    @default("MEDIUM")
  dueDate       DateTime?
  aiGenerated   Boolean   @default(false)
  createdAt     DateTime  @default(now())

  partnership Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
}

model WorkspaceMessage {
  id            String   @id @default(cuid())
  partnershipId String
  senderName    String
  senderRole    String   @default("user")
  content       String
  createdAt     DateTime @default(now())

  partnership Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
}

model Document {
  id            String   @id @default(cuid())
  partnershipId String
  title         String
  content       String?
  type          String   @default("note")
  aiGenerated   Boolean  @default(false)
  createdAt     DateTime @default(now())

  partnership Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
}

model CivicIssue {
  id          String   @id @default(cuid())
  reporterId  String
  title       String
  description String
  category    String
  address     String
  city        String
  lat         Float
  lng         Float
  images      String   @default("")
  status      String   @default("OPEN")
  priority    String   @default("MEDIUM")
  department  String?
  upvotes     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reporter User          @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  updates  IssueUpdate[]
}

model IssueUpdate {
  id        String   @id @default(cuid())
  issueId   String
  status    String
  comment   String?
  updatedBy String
  createdAt DateTime @default(now())

  issue CivicIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
